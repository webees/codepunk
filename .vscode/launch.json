{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "lldb",
      "request": "launch",
      "name": "Debug Tauri (macOS/Linux)",
      "cargo": {
        "args": ["build", "--manifest-path=src-tauri/Cargo.toml", "--no-default-features"]
      },
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "dev-server"
    },
    {
      "type": "chrome",
      "request": "launch",
      "name": "Debug webview UI",
      "url": "http://localhost:1420",
      "webRoot": "${workspaceFolder}/src"
    }
  ]
}
