{
  "name": "codepunk",
  "version": "0.1.0",
  "private": true,
  "description": "A production-grade desktop starter built with Tauri 2, Vue 3, Rsbuild, and Rust.",
  "license": "MIT",
  "author": "Codepunk contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/webees/codepunk.git"
  },
  "bugs": {
    "url": "https://github.com/webees/codepunk/issues"
  },
  "homepage": "https://github.com/webees/codepunk#readme",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@11.2.2",
  "scripts": {
    "dev": "rsbuild dev",
    "build": "vue-tsc -b && rsbuild build",
    "preview": "rsbuild preview",
    "tauri": "tauri",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "vue-tsc -b --pretty false",
    "test": "rstest run",
    "test:watch": "rstest --watch",
    "test:coverage": "rstest run --coverage",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,vue,js,mjs}": [
      "eslint --fix --max-warnings 0",
      "prettier --write"
    ],
    "*.{json,css,md,yml,yaml,html}": [
      "prettier --write"
    ],
    "*.rs": [
      "rustfmt"
    ]
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-opener": "^2.0.0",
    "vue": "^3.5.45"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^9.0.0",
    "@rsbuild/core": "^2.3.2",
    "@rsbuild/plugin-vue": "^2.0.1",
    "@rstest/adapter-rsbuild": "^0.12.6",
    "@rstest/core": "^0.12.6",
    "@rstest/coverage-v8": "^0.12.6",
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/vue": "^8.1.0",
    "@types/node": "^24.0.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-vue": "^10.12.1",
    "eslint-plugin-vuejs-accessibility": "^2.6.3",
    "globals": "^16.0.0",
    "husky": "^9.1.0",
    "jsdom": "^26.0.0",
    "lint-staged": "^16.0.0",
    "prettier": "^3.6.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.0.0",
    "vue-tsc": "^3.3.14"
  }
}
