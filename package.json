{
  "name": "codepunk",
  "version": "0.1.0",
  "private": true,
  "description": "A minimal Tauri 2 + Vue 3 + Rsbuild + Rust desktop starter.",
  "license": "MIT",
  "author": "Codepunk contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/webees/codepunk.git"
  },
  "bugs": {
    "url": "https://github.com/webees/codepunk/issues"
  },
  "type": "module",
  "engines": {
    "bun": ">=1.3.14",
    "node": "^22.13.0 || >=24"
  },
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "rsbuild dev",
    "build": "bun run typecheck && rsbuild build",
    "tauri": "tauri",
    "lint": "eslint . --max-warnings 0",
    "format:check": "prettier --check . --ignore-path .gitignore",
    "typecheck": "vue-tsc --noEmit --pretty false",
    "test": "rstest run",
    "test:coverage": "rstest run --coverage",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test",
    "prepare": "husky"
  },
  "prettier": {
    "printWidth": 100
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ],
    "rules": {
      "header-max-length": [
        2,
        "always",
        100
      ],
      "scope-enum": [
        2,
        "always",
        [
          "app",
          "ui",
          "tauri",
          "ci",
          "docs",
          "deps",
          "repo",
          "release",
          "test"
        ]
      ]
    }
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "vue": "^3.5.45"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.0",
    "@rsbuild/core": "^2.3.2",
    "@rsbuild/plugin-vue": "^2.0.1",
    "@rstest/adapter-rsbuild": "^0.12.6",
    "@rstest/core": "^0.12.6",
    "@rstest/coverage-v8": "^0.12.6",
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/vue": "^8.1.0",
    "@types/node": "^22.20.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-vue": "^10.12.1",
    "eslint-plugin-vuejs-accessibility": "^2.6.3",
    "globals": "^16.0.0",
    "husky": "^9.1.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.6.0",
    "typescript": "~5.9.0",
    "vue-tsc": "^3.3.14"
  }
}
