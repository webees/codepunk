{
  "name": "codepunk",
  "version": "0.1.0",
  "private": true,
  "description": "A minimal Tauri 2 + Vue 3 + Rsbuild + Rust desktop starter.",
  "license": "MIT",
  "author": "Codepunk contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/webees/codepunk.git"
  },
  "type": "module",
  "engines": {
    "bun": ">=1.3.14",
    "node": "^22.13.0 || >=24"
  },
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "rsbuild dev",
    "build": "bun run typecheck && rsbuild build",
    "tauri": "tauri",
    "lint": "biome ci .",
    "typecheck": "vue-tsc --noEmit --pretty false",
    "test": "rstest run --coverage",
    "check": "bun run lint && bun run typecheck && bun run test"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.5",
    "vue": "^3.5.45"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@rsbuild/core": "^2.3.2",
    "@rsbuild/plugin-vue": "^2.0.1",
    "@rstest/adapter-rsbuild": "^0.12.6",
    "@rstest/core": "^0.12.6",
    "@rstest/coverage-v8": "^0.12.6",
    "@tauri-apps/cli": "^2.12.5",
    "@types/node": "^26.6.6",
    "happy-dom": "21.0.4",
    "typescript": "^7.0.2",
    "vue-tsc": "^3.3.14"
  }
}
