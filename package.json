    "test": "bun test",
    "check": "bun run lint && bun run typecheck && bun run test"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.5",
    "vue": "^3.5.45"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@rsbuild/core": "^2.3.3",
    "@tauri-apps/cli": "^2.12.5",
    "@types/bun": "^1.4.4",
    "typescript": "^7.0.2"
  }
