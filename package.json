{
  "name": "codepunk",
  "version": "0.1.0",
  "private": true,
  "description": "Minimal Tauri and Vue shell for the Pi coding agent.",
  "license": "MIT",
  "author": "CodePunk contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/webees/codepunk.git"
  },
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "dev": "rsbuild dev",
    "build": "bun run typecheck && rsbuild build",
